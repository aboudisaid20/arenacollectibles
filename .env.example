# Stripe TEST keys. Get them from https://dashboard.stripe.com/test/apikeys
# Copy this file to .env.local (which is gitignored) and fill both in.
#
# Secret key — server only. No NEXT_PUBLIC_ prefix, so Next will never
# ship it to the browser.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Publishable key — safe to expose; it is meant to be in the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Signs session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_me

# ---------------------------------------------------------------------
# First admin account. Only read when the database is empty — changing
# these later does not change an existing login.
#
# In production ADMIN_PASSWORD is required: the app refuses to boot
# rather than seed itself with the development password below.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=replace_me_at_least_12_chars
